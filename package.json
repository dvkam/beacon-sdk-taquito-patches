{
  "name": "beacon-sdk-taquito-patches-workspace",
  "private": true,
  "version": "4.8.4-ecad",
  "description": "Workspace for the ECAD-maintained Beacon SDK packages.",
  "workspaces": [
    "packages/*"
  ],
  "keywords": [
    "airgap",
    "beacon",
    "crypto",
    "blockchain",
    "tezos",
    "decentralized",
    "dapp"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ecadlabs/beacon-sdk-taquito-patches",
  "repository": {
    "type": "git",
    "url": "https://github.com/ecadlabs/beacon-sdk-taquito-patches.git"
  },
  "packageManager": "npm@11.12.1",
  "engines": {
    "npm": ">=11.0.0",
    "node": ">=22.12.0"
  },
  "scripts": {
    "prebuild": "ts-node --project tsconfig-cjs.json scripts/generate-wallet-list.ts",
    "build": "npm run check:versions && npm run build:packages && npm run webpack:all && npm run check:sourcemaps",
    "build:packages": "node scripts/run-workspaces.mjs tsc --topological",
    "webpack:all": "npm run webpack:sdk && npm run webpack:dapp && npm run webpack:wallet",
    "webpack:sdk": "webpack --mode=development --config webpack.config.js --entry=./packages/beacon-sdk/dist/cjs/index.js --output-path ./webpack_builds/sdk && terser --ecma=12 ./webpack_builds/sdk/main.js -o ./packages/beacon-sdk/dist/walletbeacon.min.js && cp ./packages/beacon-sdk/dist/walletbeacon.min.js ./examples/walletbeacon.min.js",
    "webpack:dapp": "webpack --mode=development --entry=./packages/beacon-dapp/dist/cjs/index.js --output-path ./webpack_builds/dapp && terser --ecma=12 ./webpack_builds/dapp/main.js -o ./packages/beacon-dapp/dist/walletbeacon.dapp.min.js",
    "webpack:wallet": "webpack --mode=development --entry=./packages/beacon-wallet/dist/cjs/index.js --output-path ./webpack_builds/wallet && terser --ecma=12 ./webpack_builds/wallet/main.js -o ./packages/beacon-wallet/dist/walletbeacon.wallet.min.js",
    "prettier": "prettier --write 'src/**/*' '**/src/**/*' 'docs/**/*.md' 'example-dapp.html' 'example-wallet.html'",
    "lint": "eslint 'packages/*/src/**/*.ts'",
    "lint:fix": "eslint 'packages/*/src/**/*.ts' --fix",
    "lint:new": "node scripts/lint-new-findings.mjs",
    "test": "node scripts/run-workspaces.mjs test",
    "test-ci": "nyc --reporter=lcov npm test",
    "e2e": "playwright test e2e",
    "e2e:smoke": "playwright test e2e --grep-invert @extended",
    "audit-ci": "node scripts/dependency-scanning.js",
    "check:versions": "node scripts/check-workspace-version.mjs && node scripts/check-security-deps.mjs",
    "check:sourcemaps": "node scripts/check-sourcemaps.mjs",
    "check-version": "npm run check:versions",
    "version:sync": "node scripts/set-workspace-version.mjs",
    "readmes:sync": "node scripts/sync-package-readmes.mjs",
    "typedoc": "typedoc",
    "publish:packages": "node scripts/publish-workspaces.mjs",
    "build:ui": "cd packages/beacon-ui && npm run tsc && cd ../.. && npm run webpack:sdk"
  },
  "author": "ECAD Labs",
  "dependencies": {
    "@ecadlabs/beacon-blockchain-substrate": "file:packages/beacon-blockchain-substrate",
    "@ecadlabs/beacon-blockchain-tezos": "file:packages/beacon-blockchain-tezos",
    "@ecadlabs/beacon-blockchain-tezos-sapling": "file:packages/beacon-blockchain-tezos-sapling",
    "@ecadlabs/beacon-core": "file:packages/beacon-core",
    "@ecadlabs/beacon-dapp": "file:packages/beacon-dapp",
    "@ecadlabs/beacon-transport-matrix": "file:packages/beacon-transport-matrix",
    "@ecadlabs/beacon-transport-postmessage": "file:packages/beacon-transport-postmessage",
    "@ecadlabs/beacon-transport-walletconnect": "file:packages/beacon-transport-walletconnect",
    "@ecadlabs/beacon-types": "file:packages/beacon-types",
    "@ecadlabs/beacon-ui": "file:packages/beacon-ui",
    "@ecadlabs/beacon-utils": "file:packages/beacon-utils",
    "@ecadlabs/beacon-wallet": "file:packages/beacon-wallet",
    "@walletconnect/sign-client": "2.18.0",
    "@walletconnect/types": "2.18.0",
    "@walletconnect/utils": "2.18.0",
    "@web3modal/standalone": "2.4.3",
    "stream-browserify": "^3.0.0"
  },
  "overrides": {
    "@walletconnect/sign-client": "2.18.0",
    "@walletconnect/types": "2.18.0",
    "@walletconnect/utils": "2.18.0",
    "@babel/plugin-transform-modules-systemjs": "7.29.4",
    "fast-uri": "3.1.9",
    "unstorage": "1.17.5",
    "h3": "1.15.9",
    "defu": "6.1.7",
    "picomatch": "4.0.4",
    "flat-cache": {
      "flatted": "3.4.2"
    },
    "eslint": {
      "file-entry-cache": "8.0.0",
      "ajv": "6.14.0",
      "js-yaml": "4.3.2",
      "minimatch": "3.1.5"
    },
    "@eslint/eslintrc": {
      "ajv": "6.14.0",
      "js-yaml": "4.3.2",
      "minimatch": "3.1.5"
    },
    "@humanwhocodes/config-array": {
      "minimatch": "3.1.5"
    },
    "eslint-plugin-import": {
      "minimatch": "3.1.5"
    },
    "@rollup/pluginutils": {
      "picomatch": "4.0.4"
    },
    "@rollup/plugin-commonjs": {
      "picomatch": "4.0.4"
    },
    "@jest/transform": {
      "babel-plugin-istanbul": "8.0.0"
    },
    "babel-jest": {
      "babel-plugin-istanbul": "8.0.0"
    },
    "glob@7.2.3": {
      "minimatch": {
        "brace-expansion": "1.1.21"
      }
    },
    "glob@10.5.0": {
      "minimatch": "9.0.7"
    },
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.21"
    },
    "minimatch@9.0.7": {
      "brace-expansion": "2.1.7"
    },
    "ts-node": {
      "diff": "4.0.4"
    },
    "postcss-load-config@3.1.4": {
      "yaml": "1.10.3"
    },
    "cssnano@5.1.15": {
      "yaml": "1.10.3"
    },
    "postcss-svgo@5.1.0": {
      "svgo": "2.8.4"
    },
    "anymatch": {
      "picomatch": "2.3.2"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.7",
    "@types/elliptic": "6.4.18",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/sinon": "^21.0.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "babel-jest": "^30.5.2",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-no-null": "1.0.2",
    "eslint-plugin-prefer-arrow": "1.2.3",
    "husky": "9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jsdom": "26.1.0",
    "jsdom-global": "3.0.2",
    "nyc": "^18.0.0",
    "prettier": "^3.9.10",
    "pretty-quick": "^4.2.2",
    "sinon": "^21.1.2",
    "terser": "^5.51.2",
    "ts-node": "10.9.2",
    "typedoc": "^0.28.20",
    "typedoc-plugin-internal-external": "2.2.0",
    "typescript": "5.9.3",
    "uglify-js": "3.19.3",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
  },
  "nyc": {
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "test/**/*.spec.ts"
    ],
    "extension": [
      ".ts"
    ],
    "require": [
      "ts-node/register"
    ],
    "reporter": [
      "text",
      "text-summary"
    ],
    "sourceMap": true,
    "instrument": true
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run check:versions && pretty-quick --staged"
    }
  }
}
